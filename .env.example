# 复制为 .env 后填写：cp .env.example .env
# .env 已在 .gitignore 中，不会提交。不要把 key 写进代码、文档或聊天记录。
# 填好后启动服务，打开 /api/health：llm_configured 为 true 即生效。

# ---------- 大模型：Claude（Anthropic API）----------
# 在 https://platform.claude.com 的 API Keys 页面创建，形如 sk-ant-...
# 留空时要素抽取和类案解释自动降级为规则方式，页面仍可使用。
ANTHROPIC_API_KEY=
# 只有通过公司代理或网关访问时才填，直连官方接口留空
ANTHROPIC_BASE_URL=
# anthropic=直连官方接口；gateway=公司网关（网关会丢弃系统提示词和结构化输出参数，
# 代码会改为把指令写进用户消息、自行校验 JSON）
LLM_API_STYLE=anthropic
LLM_MODEL=claude-opus-5-5
# 推理深度 low | medium | high | xhigh | max；越高越慢、越贵。按评测结果再调
LLM_EFFORT_PARSE=low
LLM_EFFORT_EXPLAIN=medium
# 拒答时由服务端自动换模型重试（只在 anthropic 直连模式生效）
LLM_FALLBACKS=true
LLM_TIMEOUT_S=120

# 问题优化：提示词见 prompts/optimize.md，一次调用、低推理深度、不自动重试
# 可单独填写已验证可用的低延迟模型；留空复用 LLM_MODEL
LLM_MODEL_OPTIMIZE=
LLM_OPTIMIZE_TIMEOUT_S=12
LLM_OPTIMIZE_MAX_TOKENS=900

# ---------- 案例库 ----------
# mock（本地演示数据）| es（内网 ES）| replay（只回放已缓存的真实响应）
CASE_SOURCE=mock
# 连 es 时是否把响应缓存到 var/app.db，供 replay 和离线开发使用
RECORD_RESPONSES=true
ES_URL=
ES_INDEX=
ES_USERNAME=
ES_PASSWORD=

# ---------- 重排（待定，留空则沿用召回排序）----------
# 暂无可用服务，等郑元龙确认后再填。
# 默认按常见 /rerank 接口：{model, query, documents} → {results: [{index, relevance_score}]}
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=
