{
  "openapi": "3.1.0",
  "info": {
    "title": "清案 · 可信类案检索",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/query/parse": {
      "post": {
        "summary": "案情 → 可编辑的检索条件",
        "operationId": "parse_api_query_parse_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ParseRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ParseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/search": {
      "post": {
        "summary": "用确认后的条件检索",
        "operationId": "search_api_search_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}": {
      "get": {
        "summary": "文书详情与段落",
        "operationId": "get_case_api_cases__case_id__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}/explain": {
      "post": {
        "summary": "单篇相似点/差异点",
        "operationId": "explain_case_api_cases__case_id__explain_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplainRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Explanation"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/feedback": {
      "post": {
        "summary": "相关性反馈",
        "operationId": "feedback_api_feedback_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FeedbackRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "系统内部文书 ID"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "case_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Number"
          },
          "court": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "court_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court Level"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "judge_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Date",
            "description": "YYYY-MM-DD"
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause"
          },
          "doc_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Type"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "demo",
              "guiding",
              "reference",
              "judgment"
            ],
            "title": "Source Type"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields",
            "description": "底库缺失的字段；前端不展示，也不让模型补造"
          },
          "paragraphs": {
            "items": {
              "$ref": "#/components/schemas/Paragraph"
            },
            "type": "array",
            "title": "Paragraphs"
          },
          "full_text_available": {
            "type": "boolean",
            "title": "Full Text Available",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "source_type",
          "paragraphs"
        ],
        "title": "CaseDetail"
      },
      "CaseSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "系统内部文书 ID"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "case_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Number"
          },
          "court": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court"
          },
          "court_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court Level"
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "judge_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Judge Date",
            "description": "YYYY-MM-DD"
          },
          "cause": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Cause"
          },
          "doc_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Doc Type"
          },
          "source_type": {
            "type": "string",
            "enum": [
              "demo",
              "guiding",
              "reference",
              "judgment"
            ],
            "title": "Source Type"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "missing_fields": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Fields",
            "description": "底库缺失的字段；前端不展示，也不让模型补造"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "source_type"
        ],
        "title": "CaseSummary"
      },
      "Citation": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "paragraph_id": {
            "type": "string",
            "title": "Paragraph Id"
          },
          "quote": {
            "type": "string",
            "title": "Quote",
            "description": "原文引句，必须能在对应段落中逐字找到"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "case_id",
          "paragraph_id",
          "quote"
        ],
        "title": "Citation"
      },
      "ExplainRequest": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/ParsedQuery"
          },
          "search_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Id"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ExplainRequest"
      },
      "Explanation": {
        "properties": {
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "similarities": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Similarities"
          },
          "differences": {
            "items": {
              "$ref": "#/components/schemas/Point"
            },
            "type": "array",
            "title": "Differences"
          },
          "degraded": {
            "items": {
              "type": "string",
              "enum": [
                "llm_unavailable",
                "query_broadened",
                "rerank_skipped",
                "explain_fallback",
                "citation_dropped"
              ]
            },
            "type": "array",
            "title": "Degraded"
          }
        },
        "type": "object",
        "required": [
          "case_id"
        ],
        "title": "Explanation"
      },
      "FeedbackRequest": {
        "properties": {
          "search_id": {
            "type": "string",
            "title": "Search Id"
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "relevant": {
            "type": "boolean",
            "title": "Relevant"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "search_id",
          "case_id",
          "relevant"
        ],
        "title": "FeedbackRequest"
      },
      "Filters": {
        "properties": {
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region"
          },
          "year_from": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year From"
          },
          "year_to": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year To"
          },
          "court_level": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Court Level"
          }
        },
        "type": "object",
        "title": "Filters",
        "description": "用户明确指定的筛选条件，不会被系统静默放宽。"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "data_mode": {
            "type": "string",
            "enum": [
              "mock",
              "es",
              "replay"
            ],
            "title": "Data Mode"
          },
          "llm_configured": {
            "type": "boolean",
            "title": "Llm Configured"
          },
          "llm_model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Llm Model"
          },
          "rerank_configured": {
            "type": "boolean",
            "title": "Rerank Configured"
          },
          "case_type": {
            "type": "string",
            "title": "Case Type"
          }
        },
        "type": "object",
        "required": [
          "data_mode",
          "llm_configured",
          "rerank_configured",
          "case_type"
        ],
        "title": "Health"
      },
      "Hit": {
        "properties": {
          "case": {
            "$ref": "#/components/schemas/CaseSummary"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "score": {
            "type": "number",
            "title": "Score",
            "description": "内部排序分，只用于排序，不能展示为可信度"
          },
          "matched_keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Matched Keywords"
          },
          "snippets": {
            "items": {
              "$ref": "#/components/schemas/Paragraph"
            },
            "type": "array",
            "title": "Snippets",
            "description": "命中的原文段落"
          }
        },
        "type": "object",
        "required": [
          "case",
          "rank",
          "score"
        ],
        "title": "Hit"
      },
      "Paragraph": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "description": "文书内唯一的段落 ID，引用以此定位"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section",
            "description": "所属部分，如 案件事实 / 本院认为"
          },
          "text": {
            "type": "string",
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "id",
          "text"
        ],
        "title": "Paragraph"
      },
      "ParseRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 5,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ParseRequest"
      },
      "ParseResponse": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/ParsedQuery"
          },
          "degraded": {
            "items": {
              "type": "string",
              "enum": [
                "llm_unavailable",
                "query_broadened",
                "rerank_skipped",
                "explain_fallback",
                "citation_dropped"
              ]
            },
            "type": "array",
            "title": "Degraded"
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "ParseResponse"
      },
      "ParsedQuery": {
        "properties": {
          "raw_text": {
            "type": "string",
            "title": "Raw Text"
          },
          "case_type": {
            "type": "string",
            "title": "Case Type",
            "description": "当前案类，对应 configs/case_type.yaml 的 id"
          },
          "issues": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Issues",
            "description": "核心争点"
          },
          "facts": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Facts",
            "description": "用户明确给出的关键事实"
          },
          "keywords": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keywords",
            "description": "检索词"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          }
        },
        "type": "object",
        "required": [
          "raw_text",
          "case_type"
        ],
        "title": "ParsedQuery",
        "description": "系统对用户案情的理解。前端展示给用户确认、修改后再检索。"
      },
      "Point": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "origin": {
            "type": "string",
            "enum": [
              "original",
              "ai"
            ],
            "title": "Origin",
            "description": "original=原文摘录；ai=模型归纳"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/Citation"
            },
            "type": "array",
            "title": "Citations"
          }
        },
        "type": "object",
        "required": [
          "text",
          "origin"
        ],
        "title": "Point"
      },
      "SearchRequest": {
        "properties": {
          "query": {
            "$ref": "#/components/schemas/ParsedQuery"
          },
          "size": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Size",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "query"
        ],
        "title": "SearchRequest"
      },
      "SearchResponse": {
        "properties": {
          "search_id": {
            "type": "string",
            "title": "Search Id"
          },
          "data_mode": {
            "type": "string",
            "enum": [
              "mock",
              "es",
              "replay"
            ],
            "title": "Data Mode"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/Hit"
            },
            "type": "array",
            "title": "Hits"
          },
          "degraded": {
            "items": {
              "type": "string",
              "enum": [
                "llm_unavailable",
                "query_broadened",
                "rerank_skipped",
                "explain_fallback",
                "citation_dropped"
              ]
            },
            "type": "array",
            "title": "Degraded"
          },
          "took_ms": {
            "type": "integer",
            "title": "Took Ms"
          }
        },
        "type": "object",
        "required": [
          "search_id",
          "data_mode",
          "hits",
          "took_ms"
        ],
        "title": "SearchResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
